# ── Server (never exposed to the browser) ─────────────────────────────────────
X_API_BEARER_TOKEN=          # required — no fallback; scans fail without it
ANTHROPIC_API_KEY=           # optional — absent degrades to the deterministic xOnlyScan path
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # optional — preferred over the anon key for server-side writes
CRYPTORANK_API_KEY=          # optional enrichment
ROOTDATA_API_KEY=            # optional enrichment

# Admin (checked server-side by /api/admin — never ships to the client)
ADMIN_PASSWORD=              # required for admin login
ADMIN_SECRET=                # >=16 chars; signs session tokens. Unset = ephemeral, sessions end on restart

# Request guards
ALLOWED_ORIGINS=             # comma-separated extra origins allowed to call the spending routes

# ── Alpha Engine (Railway) ────────────────────────────────────────────────────
# Set as a Railway reference variable, never a pasted connection string:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
IN_PROCESS_SCHEDULER=true    # set false to run the server without the ingest/heat jobs
CHAINS=solana,base,eth       # chains the on-chain ingest watches

# ── Client (inlined into the public bundle by Vite — public by design) ────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
